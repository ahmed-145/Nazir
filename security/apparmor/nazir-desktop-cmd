#include <tunables/global>

# AppArmor profile for Nazir's Desktop Commander MCP server only.
# Attaches to /usr/local/bin/dcm-node — a thin wrapper that execs the real
# node binary. This scopes the sandbox to DCM exclusively, leaving regular
# node/npm/Gemini CLI untouched.
#
# Security model:
#   - Hard deny: .ssh, .gnupg, .env, writes outside project scope
#   - Software layer (validate_path.py + blocklist.py) enforces PROJECT_ROOT
#   - AppArmor adds OS-level hard denies on top as defense-in-depth
#
# Install:
#   sudo cp security/apparmor/nazir-desktop-cmd /etc/apparmor.d/
#   sudo apparmor_parser -r /etc/apparmor.d/nazir-desktop-cmd
#
# DCM must be launched via /usr/local/bin/dcm-node (not plain `node`).
# See security/dcm-node for the wrapper script.

profile nazir-desktop-cmd /usr/local/bin/dcm-node flags=(attach_disconnected,mediate_deleted) {

  #include <abstractions/base>
  #include <abstractions/nameservice>

  # Wrapper script itself
  /usr/local/bin/dcm-node                    r,

  # Real node binary — mrix required for V8 snapshot remapping
  /home/ahmeed/.local/bin/node               mrix,
  /home/ahmeed/.local/lib/node_modules/**    r,
  /home/ahmeed/.local/lib/node_modules/**    ix,
  /home/ahmeed/.local/bin/                   r,

  # Shared libraries
  /lib/x86_64-linux-gnu/**                   mr,
  /usr/lib/x86_64-linux-gnu/**               mr,
  /usr/lib/locale/**                          r,
  /usr/share/locale/**                        r,
  /etc/ld.so.cache                            r,

  # SSL / TLS
  /etc/ssl/**                                 r,
  /etc/ca-certificates/**                     r,

  # Network resolution
  /etc/host.conf                              r,
  /etc/hosts                                  r,
  /etc/nsswitch.conf                          r,
  /etc/resolv.conf                            r,

  # /proc entries needed by Node
  /proc/self/maps                             r,
  /proc/self/exe                              r,
  /proc/self/fd/                              r,
  /proc/self/cgroup                           r,
  /proc/version                               r,
  /proc/*/stat                                r,
  /proc/*/maps                                r,
  /sys/devices/system/cpu/                    r,
  /sys/devices/system/cpu/**                  r,

  # DCM config dir
  /home/ahmeed/.claude-server-commander/      rw,
  /home/ahmeed/.claude-server-commander/**    rw,

  # npm / node caches (read-only — DCM doesn't install packages)
  /home/ahmeed/.npm/**                        r,
  /home/ahmeed/.cache/                        r,
  /home/ahmeed/.cache/**                      r,

  # Project root: read + write
  /home/ahmeed/Documents/NEEDS/Personaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/Nazir/   r,
  /home/ahmeed/Documents/NEEDS/Personaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/Nazir/** rw,

  # Temp files
  /tmp/                                       r,
  /tmp/**                                     rw,

  # ── Hard denies (highest priority — these cannot be bypassed) ───
  deny /etc/**                                w,
  deny /usr/**                                w,
  deny /root/**                               rw,
  deny /proc/1/environ                        r,
  deny /home/ahmeed/.ssh/**                   rw,
  deny /home/ahmeed/.gnupg/**                 rw,
  deny /home/ahmeed/.bashrc                   w,
  deny /home/ahmeed/.profile                  w,
  deny /home/ahmeed/.local/bin/**             w,
  deny /home/ahmeed/Documents/NEEDS/Personaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/Nazir/.env   rw,
  deny /home/ahmeed/Documents/NEEDS/Personaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/Nazir/.git/** w,

}
